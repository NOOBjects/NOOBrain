# Copie este arquivo para .env.local e preencha. NUNCA coloque chaves secretas aqui nem no código.

# Chave gratuita do Groq: https://console.groq.com/keys  (só no servidor)
AI_API_KEY=
# Opcional. Lista de modelos em ordem de preferência (separados por vírgula)
# AI_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Opcional. Pedidos por minuto permitidos à IA (plano gratuito: 30 por modelo, usamos 25)
# AI_RPM=25

# Supabase (conta e progresso). Painel > Project Settings > API.
# A "publishable key" é pública por natureza: a proteção está nas regras de segurança por linha (RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# Opcional. "1" mostra o botão "Continuar com o Google". Só ligar depois de ativar o Google no Supabase
# (senão o botão leva a uma página de erro).
NEXT_PUBLIC_GOOGLE_LOGIN=

# hCaptcha (chave PÚBLICA do site; a secret fica só no painel do Supabase). Opcional: já há um valor por omissão em components/Account.tsx.
# NEXT_PUBLIC_HCAPTCHA_SITEKEY=
